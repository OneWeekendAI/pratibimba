{
  "name": "pratibimba-api-proxy",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Core on Cloud Run in asia-northeast3 (Seoul), next to Supabase.
  // EDGE_DECIDE: "on" answers /decide at the edge (EC2); "off" forwards every decide to Core.
  // Switch it with deploy/proxy-worker/edge-decide.sh on|off. EDGE_TOKEN is a secret (wrangler
  // secret put EDGE_TOKEN), the same value as Core's PRB_EDGE_TOKEN.
  // QUEUE_WRITES (EC3): "on" puts /e and the edge's decision records on the events queue;
  // "off" sends them to Core directly. Switch it with deploy/proxy-worker/queue.sh on|off.
  "vars": { "ORIGIN": "https://pratibimba-core-7i7wb4r5qa-du.a.run.app", "EDGE_DECIDE": "on", "QUEUE_WRITES": "on" },
  // EC1: Core writes each site's edge snapshot here (key site/<id>); the Worker reads it.
  "kv_namespaces": [{ "binding": "SNAPSHOTS", "id": "b30829cd168e42768f85c882fca47ac0" }],
  // EC2: the version beacon, one Durable Object per site, strongly consistent.
  "durable_objects": { "bindings": [{ "name": "BEACON", "class_name": "SiteBeacon" }] },
  "migrations": [{ "tag": "ec2-beacon", "new_sqlite_classes": ["SiteBeacon"] }],
  // EC3: the write buffer. This Worker produces to pratibimba-events and consumes it, sending
  // each batch to Core's /e/batch. A batch is acked only on Core's 2xx; otherwise it retries with
  // the backoff in src/index.js (RETRY_DELAYS_S), and after max_retries a message goes to the
  // dead-letter queue, which has no consumer: replay it by adding this Worker as its consumer
  // (wrangler queues consumer add pratibimba-events-dlq pratibimba-api-proxy), then removing it.
  "queues": {
    "producers": [{ "binding": "EVENTS_QUEUE", "queue": "pratibimba-events" }],
    "consumers": [{ "queue": "pratibimba-events", "max_batch_size": 100, "max_batch_timeout": 2, "max_retries": 8,
                    "dead_letter_queue": "pratibimba-events-dlq", "max_concurrency": 5 }]
  },
  "observability": { "enabled": true }
  // The live route is added by deploy/proxy-worker/switch.sh (on|off), not here, so a plain
  // `wrangler deploy` never moves production traffic.
}
