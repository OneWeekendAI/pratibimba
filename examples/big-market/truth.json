  "rates": {
    "click": { "win": 0.3, "other": 0.1 },
    "add_to_cart": { "win": 0.2, "other": 0.06 },
    "purchase": { "win": 0.12, "other": 0.03 },
    "item": { "fav": 0.5, "other": 0.08, "position_decay": 0.85, "visible": 6 }
  },
  "segments": {
    "bargain": { "sig": "from an ad, on a phone", "fav_categories": ["grocery", "kitchen"] },
    "gift": { "sig": "returning, in the evening", "fav_categories": ["toys", "books"] },
    "premium": { "sig": "desktop, direct", "fav_categories": ["electronics", "fashion"] },
    "newbie": { "sig": "new, arrived from search", "fav_categories": ["home", "beauty"] }
  },
  "winners": {
    "hero": { "bargain": "deals", "gift": "gift_picks", "premium": "new_arrivals", "newbie": "baseline" },
