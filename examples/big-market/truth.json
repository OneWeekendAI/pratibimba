    "product-badge": { "bargain": "only_few", "gift": "gifting", "premium": "bestseller", "newbie": "own" },
    "buy-button": { "bargain": "ships_today", "gift": "own", "premium": "own", "newbie": "ships_today" },
    "delivery-message": { "bargain": "price_led", "gift": "by_day", "premium": "own", "newbie": "by_day" },
    "promo-bar": { "bargain": "first_order", "gift": "none", "premium": "own", "newbie": "free_shipping" },
    "category-rows": "favourite categories first",
    "picks": "items in the favourite categories first",
    "deals": "items in the favourite categories first",
    "cart-cross-sell": "items in the favourite categories first"
  },
  "metric": {
    "hero": "click", "listing-sort": "add_to_cart", "product-badge": "add_to_cart", "buy-button": "add_to_cart",
