{
  "name": "@pratibimba/agent",
  "version": "0.1.0",
  "description": "The Pratibimba instruction pack: teaches Claude Code, Cursor or any MCP client to read results and submit variants as drafts",
  "license": "MIT",
  "homepage": "https://github.com/OneWeekendAI/pratibimba/tree/main/packages/agent#readme",
  "repository": {
